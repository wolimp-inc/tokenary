{
  "name": "@wolimp/tokenary",
  "version": "0.1.0-beta.2",
  "description": "Compile and apply reusable token replacements.",
  "author": "Pec Rodrigues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolimp-inc/tokenary.git"
  },
  "bugs": {
    "url": "https://github.com/wolimp-inc/tokenary/issues"
  },
  "homepage": "https://github.com/wolimp-inc/tokenary#readme",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup --config scripts/rollup.config.mjs",
    "test": "node --test",
    "test:dist": "node scripts/verify-build.mjs",
    "prepack": "npm run build && npm run test:dist",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "tokens",
    "replace",
    "template",
    "i18n"
  ],
  "unpkg": "./dist/tokenary.min.js",
  "jsdelivr": "./dist/tokenary.min.js",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-terser": "^1.0.0",
    "acorn": "^8.15.0",
    "rollup": "^4.52.3"
  }
}
